# awenops Docker 配置
# 复制此文件为 .env 并修改下面的值

# 管理员密码（首次启动后修改需要重新生成 hash）
ADMIN_PASSWORD=
# 至少 12 位；也可改用 AWENOPS_PASSWORD_HASH（bcrypt hash）。不要提交真实 .env。

# 必填：已发布并验收的 awen-agent tag，例如 vX.Y.Z；不自动使用 main。
AWEN_AGENT_REF=

# 访问端口（默认 8080）
PORT=8080

# 必填：至少 32 个随机字符，持久保存；不可在每次启动时重新生成。
AWENOPS_SECRET=
# 浏览器实际访问的源；使用域名/不同端口时同步修改，多个值用逗号分隔。
AWENOPS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# 默认只允许本机访问；明确需要局域网/反代访问时再改。
AWENOPS_BIND=127.0.0.1
# AWENOPS_USER=admin
